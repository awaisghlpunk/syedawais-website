---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Problem from "../components/Problem.astro";
import SystemFlow from "../components/SystemFlow.astro";
import Guarantees from "../components/Guarantees.astro";
import CaseStudies from "../components/CaseStudies.astro";
import WhyDifferent from "../components/WhyDifferent.astro";
import SystemWall from "../components/SystemWall.astro";
import Owner from "../components/Owner.astro";
import Testimonials from "../components/Testimonials.astro";
import ClosingCta from "../components/ClosingCta.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "The Break-Proof Build System — GoHighLevel, Meta Ads & AI Automation";
const description =
  "Your GoHighLevel should be booking calls right now. Instead, it's losing them. GHL systems, Meta Ads and AI automation built to be tested against real data before handoff.";
---

<BaseLayout title={title} description={description}>
  <Hero />
  <Marquee />
  <Problem />
  <SystemFlow />
  <Guarantees />
  <CaseStudies />
  <WhyDifferent />
  <SystemWall />
  <Owner />
  <Testimonials />
  <ClosingCta />
  <SiteFooter />
</BaseLayout>
