---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import { EMAIL, PHONE_E164 } from "../data/contact";

interface Props {
  title: string;
  description: string;
}

interface OgProps {
  /** Path to a page-specific social image, else the site default. */
  image?: string;
}

const { title, description, image = "/og.png" } = Astro.props as Props & OgProps;

// Trailing slash is stripped so "/services/" and "/services" both match.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

/*
  Absolute URLs, built from `site` in astro.config. Canonical and Open Graph
  both require absolute values; relative ones are ignored by crawlers and by
  every social scraper.
*/
/*
  Trailing slash included, because the build emits directories
  (/about/index.html) and the sitemap lists /about/. Canonical and sitemap
  disagreeing on the same page is worse than either form on its own.
*/
const canonicalPath = path === "/" ? "/" : `${path}/`;
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

/*
  Organization + Person, plus WebSite. Only facts that appear in the copy
  documents or in src/data/contact.ts: no invented founding date, address
  or rating.
*/
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      url: new URL("/", Astro.site).href,
      name: "The Break-Proof Build System",
      inLanguage: "en",
    },
    {
      "@type": "Organization",
      "@id": new URL("/#organization", Astro.site).href,
      name: "The Break-Proof Build System",
      url: new URL("/", Astro.site).href,
      description:
        "GoHighLevel systems, Meta Ads and AI automation, built and tested against real data before handoff.",
      email: EMAIL,
      telephone: PHONE_E164,
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        email: EMAIL,
        telephone: PHONE_E164,
        availableLanguage: "English",
      },
      founder: { "@id": new URL("/#person", Astro.site).href },
    },
    {
      "@type": "Person",
      "@id": new URL("/#person", Astro.site).href,
      name: "Syed Awais",
      jobTitle: "Growth Director",
      url: new URL("/about", Astro.site).href,
      knowsAbout: [
        "GoHighLevel",
        "Meta Ads",
        "AI automation",
        "Local SEO",
        "CRM systems",
      ],
    },
    {
      "@type": "WebPage",
      "@id": canonical,
      url: canonical,
      name: title,
      description,
      isPartOf: { "@id": new URL("/#website", Astro.site).href },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0D1A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Break-Proof Build System" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    {/* Set before first paint so the reveal styles never apply without JS. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <SiteHeader path={path} />
    <main id="main">
      <slot />
    </main>

    {/*
      Reveal + marquee-duration wiring. Inline and un-bundled on purpose: a
      deferred module could leave revealed content hidden if it loads slowly.
    */}
    <script is:inline>
      // Header surface appears once the page leaves the very top.
      (function () {
        var hdr = document.querySelector("[data-header]");
        if (!hdr) return;
        var sync = function () {
          hdr.classList.toggle("is-stuck", window.scrollY > 12);
        };
        sync();
        window.addEventListener("scroll", sync, { passive: true });
      })();

      (function () {
        var nodes = document.querySelectorAll("[data-reveal]");
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function showAll() {
          for (var i = 0; i < nodes.length; i++) nodes[i].classList.add("is-in");
        }

        if (reduced || !("IntersectionObserver" in window)) {
          showAll();
          return;
        }

        try {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              });
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
          );

          for (var i = 0; i < nodes.length; i++) {
            // Anything already on screen at load reveals immediately.
            io.observe(nodes[i]);
          }
        } catch (err) {
          // Observer never got off the ground — show everything rather than
          // stranding content behind an animation that will never run.
          showAll();
        }
      })();
    </script>
  </body>
</html>
