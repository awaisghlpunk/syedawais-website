---
/*
  Testimonials — staggered/rotated cards for depth.
  Quotes are intentionally left as placeholder bracket text; real ones are
  still outstanding and nothing here should read as a genuine client quote.
*/
import SectionBg from "./SectionBg.astro";

const quotes = [
  "[Client quote about a specific result and reliability]",
  "[Client quote about communication and follow-through]",
  "[Client quote about the system still working months later]",
];
---

<section class="section" id="testimonials">
  <SectionBg
    pattern="diag"
    glow="blue"
    glowX="86%"
    glowY="100%"
    glowW="660px"
    glowH="480px"
    scrimPos="40% 34%"
    scrimH="70%"
  />

  <div class="shell">
    <p class="kicker" data-reveal>What clients say</p>
    <h2 class="h2" data-reveal style="--d: 60ms">Don't take our word for it.</h2>

    <div class="quotes">
      {
        quotes.map((quote, i) => (
          <figure class="quote" data-reveal="scale" style={`--d: ${120 + i * 120}ms`}>
            <span class="quote__mark" aria-hidden="true">
              &ldquo;
            </span>

            <blockquote class="quote__text">{quote}</blockquote>

            <figcaption class="quote__by">
              <span class="quote__avatar" aria-hidden="true" />
              <span class="quote__meta">
                <span class="quote__name">Name, Business, Industry</span>
                <span class="quote__pending mono">Awaiting real testimonial</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <a class="quotes__link" href="#testimonials" data-reveal>
      See All Testimonials <span class="arrow">→</span>
    </a>
  </div>
</section>

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 68px;
  }

  .quote {
    position: relative;
    margin: 0;
    padding: 34px 28px 26px;
    border-radius: 14px;
    background: var(--card);
    border: 1px solid var(--card-line);
    transition: transform 0.45s var(--ease), border-color 0.45s var(--ease),
      background 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }

  /* Slight rotation + vertical offset gives the row depth. */
  .quote:nth-child(1) {
    transform: rotate(-1.1deg);
  }

  .quote:nth-child(2) {
    transform: rotate(0.5deg) translateY(18px);
  }

  .quote:nth-child(3) {
    transform: rotate(1.3deg) translateY(-8px);
  }

  .quote:hover {
    transform: rotate(0deg) translateY(-6px);
    border-color: rgba(198, 255, 61, 0.3);
    background: rgba(255, 255, 255, 0.055);
    box-shadow: 0 26px 50px -28px rgba(0, 0, 0, 0.95);
    z-index: 2;
  }

  .quote__mark {
    display: block;
    font-family: var(--font-display);
    font-size: 46px;
    line-height: 0.6;
    color: var(--accent);
    opacity: 0.55;
    margin-bottom: 16px;
  }

  .quote__text {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.72;
    color: var(--ink-soft);
    min-height: 96px;
  }

  .quote__by {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .quote__avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    flex: none;
    background: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.05) 0px,
      rgba(255, 255, 255, 0.05) 5px,
      transparent 5px,
      transparent 10px
    );
    border: 1px solid var(--card-line);
  }

  .quote__meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .quote__name {
    font-size: 13.5px;
    color: var(--ink-mute);
  }

  .quote__pending {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .quotes__link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 52px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .quotes__link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 900px) {
    .quotes {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-top: 44px;
    }

    /* Drop the rotation once the cards stack — it reads as misalignment. */
    .quote:nth-child(1),
    .quote:nth-child(2),
    .quote:nth-child(3) {
      transform: none;
    }

    .quote:hover {
      transform: translateY(-4px);
    }

    .quote__text {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .quote {
      padding: 28px 22px 22px;
    }

    .quote__text {
      font-size: 15px;
    }

    .quotes__link {
      margin-top: 36px;
    }
  }
</style>
