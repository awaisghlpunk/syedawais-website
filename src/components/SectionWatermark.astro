---
/*
  Large faded vendor mark in a section corner, in the platform's own colours.
  Tilted and masked so it is solid at its outer corner and gone before it
  reaches the copy.

  Only use a mark the section's own copy actually names.
*/
interface Props {
  id: "ghl" | "meta" | "n8n" | "gbp";
  side?: "left" | "right";
  width?: string;
  opacity?: string;
  bottom?: string;
  tilt?: string;
}

const {
  id,
  side = "left",
  width = "820px",
  opacity = "0.14",
  /* Sunk into the corner: at a shallower offset it crowded the section CTA
     that sits at the bottom left of these sections. */
  bottom = "-30px",
  tilt = "12deg",
} = Astro.props;

const rotate = side === "left" ? tilt : `-${tilt}`;
const maskAngle = side === "left" ? "48deg" : "312deg";
const edge =
  side === "left" ? "left:-150px;right:auto;" : "right:-150px;left:auto;";
const origin = side === "left" ? "0% 100%" : "100% 100%";
---

<span
  class="wm"
  aria-hidden="true"
  style={`${edge}bottom:${bottom};width:${width};opacity:${opacity};--rot:${rotate};--mask:${maskAngle};--origin:${origin};`}
>
  {
    id === "ghl" && (
      <svg viewBox="0 0 120 84">
        <path d="M32 26 47 44h-8v32H25V44h-8Z" fill="#FBBC05" />
        <path d="M60 40 75 58h-8v18H53V58h-8Z" fill="#4285F4" />
        <path d="M88 18l15 18h-8v40H81V36h-8Z" fill="#34A853" />
      </svg>
    )
  }

  {
    id === "meta" && (
      <svg viewBox="0 0 120 72" fill="none">
        <path
          d="M30 36C30 20 45 20 60 36S90 52 90 36 75 20 60 36 30 52 30 36Z"
          stroke="#0081FB"
          stroke-width="13"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }

  {
    id === "n8n" && (
      <svg viewBox="0 0 120 64" fill="none">
        <g stroke="#EA4B71" stroke-width="7" stroke-linecap="round">
          <circle cx="14" cy="32" r="9" />
          <circle cx="46" cy="32" r="11" />
          <circle cx="100" cy="14" r="11" />
          <circle cx="100" cy="50" r="11" />
          <path d="M25 32h9" />
          <path d="M57 32h12" />
          <path d="M69 32c9 0 8-18 18-18" />
          <path d="M69 32c9 0 8 18 18 18" />
        </g>
      </svg>
    )
  }

  {
    id === "gbp" && (
      <svg viewBox="0 0 100 100" fill="none">
        <path
          d="M50 8c-16 0-29 13-29 29 0 22 29 55 29 55s29-33 29-55c0-16-13-29-29-29Z"
          stroke="#34A853"
          stroke-width="10"
        />
        <circle cx="50" cy="37" r="11" fill="#34A853" />
      </svg>
    )
  }
</span>

<style>
  .wm {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    transform: rotate(var(--rot));
    transform-origin: var(--origin);
    -webkit-mask-image: linear-gradient(
      var(--mask),
      #000 0%,
      rgba(0, 0, 0, 0.5) 40%,
      rgba(0, 0, 0, 0.12) 68%,
      transparent 88%
    );
    mask-image: linear-gradient(
      var(--mask),
      #000 0%,
      rgba(0, 0, 0, 0.5) 40%,
      rgba(0, 0, 0, 0.12) 68%,
      transparent 88%
    );
  }

  .wm svg {
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .wm {
      width: 520px !important;
    }
  }

  @media (max-width: 640px) {
    .wm {
      width: 360px !important;
      opacity: 0.12 !important;
    }
  }
</style>
