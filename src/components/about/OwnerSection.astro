---
import SectionBg from "../SectionBg.astro";
import SectionWatermark from "../SectionWatermark.astro";
import PlaceholderImage from "../PlaceholderImage.astro";

/* Photo and text split, photo desaturated, per the design system. */
---

<section class="section section--alt" id="owner">
  <SectionBg
    pattern="rings"
    corner="98% 90%"
    glow="lime"
    glowX="84%"
    glowY="101%"
    glowW="660px"
    glowH="520px"
  />

  <SectionWatermark id="ghl" side="right" width="640px" />

  <div class="shell">
    <p class="kicker" data-reveal>Who's behind the Break-Proof Build System</p>

    <div class="owner">
      <figure class="owner__photo" data-reveal="left" style="--d: 80ms">
        <PlaceholderImage
          id="owner-photo-section"
          label="Owner Photo (B&W)"
          note="owner portrait, black and white, one side of The Owner section"
          w={600}
          h={750}
        />
      </figure>

      <div class="owner__text" data-reveal="right" style="--d: 120ms">
        <p class="owner__body">
          Every system on this site is built by one person, not a team you'll
          never talk to, not a coordinator relaying your requirements down a
          chain. The background is mechanical engineering, and it shows up
          directly in how these systems get built: tested under real conditions
          before they're ever called finished, documented well enough that
          you're never stuck needing someone else to explain your own system.
        </p>

        <p class="owner__facts">
          Growth Director at Hainan Corporate Services Group. 15+ GHL systems
          built. 20+ businesses served. Building GHL systems since 2019.
        </p>

        <div class="section-cta">
          <a class="btn btn--outline" href="#story">
            Why engineering matters <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .owner {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: center;
    margin-top: 46px;
  }

  .owner__photo {
    margin: 0;
  }

  .owner__photo :global(.ph img) {
    filter: grayscale(100%) contrast(1.04);
    transition: transform 0.6s var(--ease);
  }

  .owner__photo:hover :global(.ph img) {
    transform: scale(1.03);
  }

  .owner__body {
    font-size: 17.5px;
    line-height: 1.78;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .owner__facts {
    margin-top: 24px;
    padding: 18px 22px;
    border-left: 2px solid var(--accent);
    background: linear-gradient(90deg, rgba(198, 255, 61, 0.06), transparent 74%);
    border-radius: 0 10px 10px 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-body);
    max-width: 62ch;
  }

  @media (max-width: 900px) {
    .owner {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 34px;
    }

    .owner__photo {
      max-width: 400px;
    }
  }

  @media (max-width: 640px) {
    .owner__body {
      font-size: 15.5px;
    }

    .owner__facts {
      font-size: 15px;
      padding: 16px 18px;
    }
  }
</style>
