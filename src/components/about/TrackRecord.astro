---
import SectionBg from "../SectionBg.astro";

/* Four figures, exactly as written in the copy. Nothing added. */
const stats = [
  { num: "20+", label: "Websites built" },
  { num: "15+", label: "GHL systems built" },
  { num: "20+", label: "Sites ranked #1" },
  { num: "20+", label: "Businesses served" },
];
---

<section class="section section--alt" id="track-record">
  <SectionBg
    pattern="grid"
    corner="98% 6%"
    glow="lime"
    glowX="84%"
    glowY="101%"
    glowW="700px"
    glowH="540px"
    puffX="34%"
    puffY="26%"
  />

  <div class="shell">
    <p class="kicker" data-reveal>What's actually been built</p>
    <h2 class="h2" data-reveal style="--d: 60ms">Real numbers from real systems.</h2>

    <div class="stats">
      {
        stats.map((s, i) => (
          <div class="stat" data-reveal="scale" style={`--d: ${100 + i * 90}ms`}>
            <p class="stat__num mono">{s.num}</p>
            <p class="stat__label">{s.label}</p>
          </div>
        ))
      }
    </div>

    <p class="support" data-reveal>
      2.5M+ impressions, 35,000+ clicks generated across local SEO clients.
    </p>

    <div class="section-cta" data-reveal>
      <a class="btn btn--outline" href="#philosophy">
        How I think about growth <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-top: 52px;
  }

  .stat {
    padding: 34px 26px 30px;
    border: 1px solid var(--card-line);
    border-radius: 16px;
    background: var(--card);
    transition: transform 0.4s var(--ease), border-color 0.4s var(--ease),
      background 0.4s var(--ease);
  }

  .stat:hover {
    transform: translateY(-5px);
    border-color: rgba(198, 255, 61, 0.34);
    background: rgba(255, 255, 255, 0.07);
  }

  .stat__num {
    font-size: clamp(38px, 4.4vw, 54px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
    transition: transform 0.4s var(--ease);
  }

  .stat:hover .stat__num {
    transform: translateY(-3px);
  }

  .stat__label {
    margin-top: 14px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-mute);
  }

  .support {
    margin-top: 26px;
    padding: 18px 22px;
    border-left: 2px solid var(--accent);
    background: linear-gradient(90deg, rgba(198, 255, 61, 0.06), transparent 74%);
    border-radius: 0 10px 10px 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 62ch;
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin-top: 38px;
    }

    .stat {
      padding: 26px 20px 24px;
    }
  }

  @media (max-width: 640px) {
    .support {
      font-size: 15px;
      padding: 16px 18px;
    }
  }
</style>
