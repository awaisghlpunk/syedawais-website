---
import SectionBg from "../SectionBg.astro";
import { EMAIL, MAILTO, PHONE_DISPLAY, WHATSAPP_URL } from "../../data/contact";
---

<section class="section" id="other-ways">
  <SectionBg
    pattern="dots"
    corner="98% 90%"
    glow="blue"
    glowX="18%"
    glowY="100%"
    glowW="640px"
    glowH="520px"
  />

  <div class="shell">
    <p class="kicker" data-reveal>Prefer something else?</p>
    <h2 class="h2 h2--wide" data-reveal style="--d: 60ms">
      If a call isn't the right first step for you, here's how else to get in
      touch:
    </h2>

    <ul class="ways">
      <li class="way" data-reveal style="--d: 100ms">
        <span class="way__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
            <path
              d="M3 7.5A2.5 2.5 0 0 1 5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5v-9Zm1 .3 8 5.2 8-5.2"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="way__text">
          <span class="way__label mono">Email</span>
          <a class="way__value way__link" href={MAILTO}>{EMAIL}</a>
        </span>
      </li>

      <li class="way" data-reveal style="--d: 170ms">
        <span class="way__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
            <path
              d="M21 11.7a8.5 8.5 0 0 1-12.5 7.5L3.5 21l1.9-4.8A8.5 8.5 0 1 1 21 11.7Z"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linejoin="round"></path>
            <path
              d="M8.9 9.1c.3-.6.6-.6.9-.6h.6c.2 0 .5 0 .7.5l.7 1.7c.1.2 0 .5-.1.6l-.5.5c-.1.2-.2.3 0 .6.5.8 1.2 1.4 2 1.8.3.2.5.1.6 0l.6-.6c.2-.2.4-.2.6-.1l1.6.8c.3.1.4.3.4.5v.7c0 .4-.3.9-.9 1a4 4 0 0 1-2.5-.4 9 9 0 0 1-4.2-4c-.4-.8-.6-1.9-.5-2.5Z"
              fill="currentColor"></path>
          </svg>
        </span>
        <span class="way__text">
          <span class="way__label mono">WhatsApp</span>
          <a
            class="way__value way__link"
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            {PHONE_DISPLAY}
          </a>
        </span>
      </li>

      <li class="way" data-reveal style="--d: 240ms">
        <span class="way__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
            <path
              d="M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="way__text">
          <span class="way__label mono">Response time</span>
          <span class="way__value">
            Usually within a few hours, always within one business day
          </span>
        </span>
      </li>
    </ul>
  </div>
</section>

<style>
  .ways {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    list-style: none;
    margin: 46px 0 0;
    padding: 0;
  }

  .way {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 24px 22px;
    border: 1px solid var(--card-line);
    border-radius: 14px;
    background: var(--card);
    transition: transform 0.4s var(--ease), border-color 0.4s var(--ease);
  }

  .way:hover {
    transform: translateY(-4px);
    border-color: rgba(198, 255, 61, 0.3);
  }

  .way__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--card-line);
    background: rgba(198, 255, 61, 0.08);
    color: var(--accent);
    flex: none;
  }

  .way__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .way__label {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .way__value {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .way__link {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(198, 255, 61, 0.3);
    padding-bottom: 1px;
    align-self: flex-start;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }

  .way__link:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (max-width: 900px) {
    .ways {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 34px;
    }
  }
</style>
