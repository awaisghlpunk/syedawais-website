---
/*
  Case Studies — alternating left/right rows, text + stat box, order flipping
  each row. Every figure below is drawn from the verified data set.
*/
import SectionBg from "./SectionBg.astro";
import ToolMark from "./ToolMark.astro";

/*
  `tools` lists only what each case study's own copy names. Every case
  mentions pipelines, which is GoHighLevel, so it appears on all four.

  Three of the four say "AI" without naming a vendor, so those carry a text
  note rather than a Claude, OpenAI or n8n mark: putting a specific logo on
  a client build would assert a tool the copy does not support.

  Google Business Profile on the local SEO case is inferred from the work
  described, not named in the copy.
*/
const studies = [
  {
    id: "hainan-corporate-services-group",
    name: "Hainan Corporate Services Group",
    tag: "AI Workflows · Qualification · Follow-Up",
    tools: ["ghl", "meta"],
    body: "Every lead this company got came through a WhatsApp number one person checked when they remembered to. No CRM meant no way to know if a lead ever got a reply, or just quietly disappeared. We built 5 pipelines inside GoHighLevel, fed directly by Meta Ads, with AI-powered workflows moving leads through qualification and follow-up automatically.",
    result:
      "$1M in leads sitting in pipeline every month, at a 10% on-paper conversion rate, from Meta Ads alone.",
    stats: [
      { num: "5", label: "Pipelines built" },
      { num: "$1M", label: "In pipeline / month" },
      { num: "10%", label: "On-paper conversion" },
    ],
  },
  {
    id: "hainan-apex-traders",
    name: "Hainan Apex Traders",
    tag: "AI Chatbot · Automated Follow-Up",
    tools: ["ghl"],
    body: "Leads came in through paid ads and cold outreach, but nothing guaranteed any of them actually got followed up on before they went cold. We built 3 pipelines, an AI chatbot handling qualification and booking, and automated follow-up so nothing sits untouched.",
    result:
      "$500K in pipeline from ads, $200K from cold outreach. 30% conversion rate from the funnel. 40% more bookings since the chatbot went live.",
    stats: [
      { num: "3", label: "Pipelines built" },
      { num: "$500K", label: "Pipeline from ads" },
      { num: "$200K", label: "From cold outreach" },
      { num: "30%", label: "Funnel conversion" },
      { num: "40%", label: "More bookings" },
    ],
  },
  {
    id: "nationwide-rv",
    name: "Nationwide RV",
    tag: "Funnels · Automation · UTM Attribution",
    tools: ["ghl", "gads", "ganalytics", "gtm"],
    body: "Leads were coming in through Google Ads with no automation system built around them and no reliable way to trace which campaigns actually worked. We built funnels and a full automation system, fully matched to their pipeline, with UTM tracking wired through Google Analytics and Tag Manager.",
    result:
      "Handles up to $70K in Google Ad spend leads, fully automated, with clean attribution from click to pipeline stage.",
    stats: [
      { num: "$70K", label: "Ad spend handled" },
      { num: "UTM", label: "GA + GTM tracking" },
    ],
  },
  {
    id: "local-seo-home-services",
    name: "Local SEO: Home Services",
    tag: "Local SEO · Lead Generation",
    tools: ["ghl", "gbp"],
    body: "Searched for, and found nowhere. A customer looking for exactly what these businesses sold would scroll past them without knowing they existed. We built a repeatable local SEO system and ran it across 20+ businesses.",
    result:
      "20+ pipelines generating more than $10M in leads in pipeline, converting above industry-standard rates.",
    stats: [
      { num: "20+", label: "Pipelines" },
      { num: "$10M+", label: "Leads in pipeline" },
      { num: "20+", label: "Businesses served" },
    ],
  },
];
---

<section class="section" id="case-studies">
  <SectionBg
    pattern="rings"
    corner="100% 97%"
    glow="lime"
    glowX="88%"
    glowY="-2%"
    glowW="760px"
    glowH="560px"
    glowA="0.09"
    scrimPos="36% 30%"
    scrimH="76%"
  />

  {/*
    Section watermark. The System section already carries GoHighLevel, so
    this takes the ad platform instead: it keeps the two headline channels
    on separate sections, and the per-case rows below carry GoHighLevel on
    every study anyway.
  */}
  <span class="cs-watermark" aria-hidden="true">
    <svg viewBox="0 0 120 72" fill="none">
      <path
        d="M30 36C30 20 45 20 60 36S90 52 90 36 75 20 60 36 30 52 30 36Z"
        stroke="#0081FB"
        stroke-width="13"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>

  <div class="shell">
    <p class="kicker" data-reveal>Real systems, real results</p>
    <h2 class="h2 h2--wide" data-reveal style="--d: 60ms">
      Here's what this looked like before we touched it.
    </h2>

    <div class="cases">
      {
        studies.map((study, i) => (
          <article class="case" id={study.id}>
            <div class="case__stack" data-reveal>
              <span class="case__marks">
                {study.tools.map((t) => (
                  <ToolMark id={t as any} size={22} />
                ))}
              </span>
              <p class="case__tag mono">{study.tag}</p>
            </div>
            <h3 class="case__name" data-reveal style="--d: 60ms">
              {study.name}
            </h3>
            <p class="case__body" data-reveal style="--d: 100ms">
              {study.body}
            </p>

            <p class="case__result" data-reveal style="--d: 140ms">
              <span class="case__result-label">Result</span>
              {study.result}
            </p>

            <ul
              class="stat-row"
              data-reveal
              style={`--d: 180ms; --cols: ${study.stats.length}`}
            >
              {study.stats.map((s) => (
                <li class="stat">
                  <span class="stat__num mono">{s.num}</span>
                  <span class="stat__label">{s.label}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="section-cta" data-reveal>
      <a class="btn btn--outline" href="#system-wall">
        See every system <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cs-watermark {
    position: absolute;
    right: -120px;
    bottom: 40px;
    width: 760px;
    z-index: 1;
    opacity: 0.16;
    pointer-events: none;
    transform: rotate(-12deg);
    transform-origin: 100% 100%;
    /* Solid at the outer corner, gone before it reaches the copy. */
    -webkit-mask-image: linear-gradient(
      312deg,
      #000 0%,
      rgba(0, 0, 0, 0.5) 40%,
      rgba(0, 0, 0, 0.12) 68%,
      transparent 88%
    );
    mask-image: linear-gradient(
      312deg,
      #000 0%,
      rgba(0, 0, 0, 0.5) 40%,
      rgba(0, 0, 0, 0.12) 68%,
      transparent 88%
    );
  }

  .cs-watermark svg {
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .cs-watermark {
      width: 520px;
      right: -80px;
      bottom: 28px;
    }
  }

  @media (max-width: 560px) {
    .cs-watermark {
      width: 360px;
      right: -60px;
      opacity: 0.13;
    }
  }

  /*
    Full-width block per case study, with the numbers in a divided strip
    underneath. The previous layout floated a stat card beside the copy: the
    card was vertically centred against a much taller text column, and the
    stats sat in a fixed two-column grid that orphaned the third value and
    crowded the five-stat case. A strip tiles evenly at any count.
  */
  .cases {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
  }

  .case {
    padding: 52px 0;
    border-top: 1px solid var(--line);
  }

  .case:first-child {
    border-top: none;
    padding-top: 4px;
  }

  .case:last-child {
    padding-bottom: 4px;
  }

  .case__stack {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .case__marks {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 10px;
    border: 1px solid var(--card-line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
  }

  .case__tag {
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }

  /*
    The tag carries only what the marks do not: the vendor names moved into
    logos, so repeating them here read as duplication. Anything left is a
    capability rather than a product, including AI, which the copy names
    without naming a vendor.
  */

  .case__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 16px;
  }

  .case__body {
    font-size: 16.5px;
    line-height: 1.74;
    color: var(--ink-body);
    max-width: 62ch;
  }

  .case__result {
    position: relative;
    margin-top: 24px;
    padding: 18px 22px;
    border-left: 2px solid var(--accent);
    background: linear-gradient(
      90deg,
      rgba(198, 255, 61, 0.055),
      transparent 75%
    );
    border-radius: 0 10px 10px 0;
    font-size: 15.5px;
    line-height: 1.66;
    color: var(--ink-soft);
    max-width: 64ch;
  }

  .case__result-label {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 7px;
  }

  /* Stat strip ------------------------------------------------------------ */

  .stat-row {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    border-top: 1px solid var(--card-line);
    border-bottom: 1px solid var(--card-line);
  }

  .stat {
    padding: 20px 22px 18px;
    border-right: 1px solid var(--card-line);
    transition: background 0.35s var(--ease);
  }

  .stat:first-child {
    padding-left: 0;
  }

  .stat:last-child {
    border-right: none;
  }

  .stat:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .stat__num {
    display: block;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.05;
    color: var(--accent);
    letter-spacing: -0.02em;
    transition: transform 0.35s var(--ease);
  }

  .stat:hover .stat__num {
    transform: translateY(-3px);
  }

  .stat__label {
    display: block;
    font-size: 12px;
    line-height: 1.45;
    color: var(--ink-faint);
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .cases {
      margin-top: 44px;
    }

    .case {
      padding: 40px 0;
    }

    /* Five columns is too many once the shell narrows; wrap to three and
       let the row borders carry the grid. */
    .stat-row {
      grid-template-columns: repeat(3, 1fr);
    }

    .stat {
      border-bottom: 1px solid var(--card-line);
    }

    .stat:last-child,
    .stat:nth-child(3n) {
      border-right: none;
    }
  }

  @media (max-width: 640px) {
    .case__body {
      font-size: 15px;
    }

    .case__result {
      padding: 16px 18px;
      font-size: 15px;
    }

    .stat-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat {
      padding: 16px 14px 14px;
    }

    .stat:nth-child(3n) {
      border-right: 1px solid var(--card-line);
    }

    .stat:nth-child(2n),
    .stat:last-child {
      border-right: none;
    }

    .stat__num {
      font-size: 25px;
    }
  }
</style>
