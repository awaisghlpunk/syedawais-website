---
import SectionBg from "../SectionBg.astro";
import SectionWatermark from "../SectionWatermark.astro";

/*
  Three tiers. Command Center reads as the most complete option through
  scale and contrast alone: a lime border, a lifted surface and a solid
  CTA. No "most popular" badge, since the brief rules that out.

  Prices, inclusions, delivery and support are exactly as written in the
  copy. Nothing here is inferred.
*/
const tiers = [
  {
    name: "GHL Ignition Sprint",
    price: "$350",
    who: "Solopreneurs and small businesses just getting into GHL.",
    includes: [
      "1 pipeline, fully tagged and organized",
      "1 funnel + 1 form",
      "3 core automations",
      "Email deliverability set up correctly (SPF, DKIM, DMARC)",
      "1 Loom walkthrough, so you know how it works",
    ],
    delivery: "5 days",
    support: "7 days of email support after launch",
    note: "Not yet confirmed by user, pulled from the data pack, unlike the other two tiers below.",
    featured: false,
  },
  {
    name: "GHL Growth Engine",
    price: "$1,200",
    who: "Agencies and growing businesses that need more than the basics.",
    includes: [
      "1 pipeline, with every workflow needed to cover the full lead lifecycle, first stage to last, including lead recovery",
      "Complete GHL setup and integrations",
      "Full booking system, including no-show workflows",
      "A GHL chatbot for instant lead response",
      "Full testing, checked against real data, not a demo",
      "Complete system documentation",
      "Team-guided Loom walkthroughs",
      "1 funnel + forms",
    ],
    delivery: "Milestone-based, typically within a month",
    support: "30 days of monitoring and fixes after launch",
    note: "No Meta Pixel or ad campaign setup in this tier, that's covered separately or in Command Center.",
    featured: false,
  },
  {
    name: "GHL Command Center",
    price: "$3,500",
    who: "Established businesses ready to go all-in.",
    includes: [
      "AI-powered Sales Briefing Agents, your sales team walks into every meeting already knowing the lead",
      "3 pipelines, more if your business needs them",
      "Automations built for each pipeline's stages, not one generic sequence stretched across everything",
      "Full Meta Ads setup, including lead generation running through Meta Ads",
      "The full path covered: lead in, all the way to a meeting actually booked on your sales team's calendar, built around your specific sales cycle, not a generic one",
      "Social account integration with posting schedules",
      "Unlimited automations",
      "AI chatbot and voice agents",
      "The automated webinar system, fully self-running, dates and reporting included",
      "Multi-platform integrations",
      "Team training, not just owner training",
      "The System Bible + SOPs + full team onboarding",
    ],
    delivery: "Milestone-based, typically within a month",
    support: "60 days of monitoring with priority response",
    note: "",
    featured: true,
  },
];
---

<section class="section section--alt" id="packages">
  <SectionBg
    pattern="grid"
    corner="100% 5%"
    glow="lime"
    glowX="86%"
    glowY="101%"
    glowW="700px"
    glowH="520px"
  />

  {/* Every tier is a GoHighLevel build, so the mark is accurate here. */}
  <SectionWatermark id="ghl" side="left" width="600px" />

  <div class="shell">
    <p class="kicker" data-reveal>Three ways to start</p>
    <h2 class="h2 h2--wide" data-reveal style="--d: 60ms">
      Pick the tier that matches what your business needs handled right now.
    </h2>

    <div class="tiers">
      {
        tiers.map((t, i) => (
          <article
            class={`tier${t.featured ? " is-featured" : ""}`}
            data-reveal
            style={`--d: ${120 + i * 110}ms`}
          >
            <header class="tier__head">
              <h3 class="tier__name">{t.name}</h3>
              <p class="tier__price mono">{t.price}</p>
              <p class="tier__who">
                <span class="tier__who-label mono">For</span>
                {t.who}
              </p>
            </header>

            <p class="tier__label mono">What's included</p>
            <ul class="tier__list">
              {t.includes.map((inc) => (
                <li>
                  <span class="tier__tick" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none">
                      <path
                        d="M20 6 9 17l-5-5"
                        stroke="currentColor"
                        stroke-width="2.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  {inc}
                </li>
              ))}
            </ul>

            {t.note && <p class="tier__note">{t.note}</p>}

            <dl class="tier__meta">
              <div>
                <dt class="mono">Delivery</dt>
                <dd>{t.delivery}</dd>
              </div>
              <div>
                <dt class="mono">Support</dt>
                <dd>{t.support}</dd>
              </div>
            </dl>

            <a
              class={`btn ${t.featured ? "btn--accent" : "btn--outline"} tier__cta`}
              href="#book"
            >
              Book a free call <span class="arrow">→</span>
            </a>
          </article>
        ))
      }
    </div>

    <p class="transition-note" data-reveal>
      Every tier gets the same three guarantees. What changes is scope, not
      whether it's backed up.
    </p>

    <p class="addons" data-reveal>
      <span class="addons__label mono">Add-ons available separately</span>
      AI Booking Booster (chatbot + voice agents), Meta Ads Lead Engine setup,
      ongoing Meta Ads management, GHL Deliverability Fix, and the Automated
      Webinar System as a standalone add-on if you're not on Command Center.
    </p>
  </div>
</section>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 60px;
    align-items: start;
  }

  .tier {
    display: flex;
    flex-direction: column;
    padding: 30px 28px 28px;
    border: 1px solid var(--card-line);
    border-radius: 16px;
    background: var(--card);
    transition: transform 0.4s var(--ease), border-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .tier:hover {
    transform: translateY(-5px);
    border-color: rgba(198, 255, 61, 0.32);
    box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.9);
  }

  /* The most complete tier, distinguished by weight rather than a badge. */
  .tier.is-featured {
    border-color: rgba(198, 255, 61, 0.45);
    background: linear-gradient(
      165deg,
      rgba(198, 255, 61, 0.07),
      rgba(255, 255, 255, 0.03) 52%
    );
  }

  .tier__head {
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }

  .tier__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink);
  }

  .tier__price {
    font-size: 38px;
    line-height: 1.1;
    color: var(--accent);
    margin: 10px 0 14px;
  }

  .tier__who {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ink-mute);
  }

  .tier__who-label {
    display: block;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 6px;
  }

  .tier__label {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 14px;
  }

  .tier__list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .tier__list li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 14.5px;
    line-height: 1.62;
    color: var(--ink-body);
    padding: 9px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .tier__list li:last-child {
    border-bottom: none;
  }

  .tier__tick {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: rgba(198, 255, 61, 0.12);
    border: 1px solid rgba(198, 255, 61, 0.3);
    color: var(--accent);
    flex: none;
    margin-top: 2px;
  }

  /* Caveats from the copy, kept visually distinct from inclusions. */
  .tier__note {
    margin-top: 16px;
    padding: 12px 14px;
    border: 1px dashed var(--card-line);
    border-radius: 9px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-mute);
  }

  .tier__meta {
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 12px;
  }

  .tier__meta dt {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 4px;
  }

  .tier__meta dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .tier__cta {
    margin-top: 24px;
    justify-content: center;
  }

  .addons {
    margin-top: 26px;
    padding: 20px 24px;
    border: 1px solid var(--card-line);
    border-radius: 12px;
    background: var(--card);
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-body);
    max-width: 82ch;
  }

  .addons__label {
    display: block;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }

  @media (max-width: 1000px) {
    .tiers {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 44px;
    }
  }

  @media (max-width: 640px) {
    .tier {
      padding: 26px 20px 24px;
    }

    .tier__price {
      font-size: 32px;
    }

    .addons {
      padding: 18px 18px;
      font-size: 14.5px;
    }
  }
</style>
