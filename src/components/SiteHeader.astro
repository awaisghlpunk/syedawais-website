---
/*
  Shared site header. Fixed so the hero gradient runs behind it, with the
  hero carrying matching top padding.

  Transparent over the hero, then picks up a blurred surface and a hairline
  once the page scrolls, via a class toggled by the inline script in the
  layout.

  The mobile menu is a checkbox and label, no script: the header stays part
  of the zero-JS-bundle budget.

  Section links are absolute (/#id). Bare fragments would dead-end on any
  page that does not contain that section.
*/
interface Props {
  path?: string;
}

const { path = "/" } = Astro.props;

const links = [
  { label: "Home", href: "/", match: "/" },
  { label: "Services", href: "/services", match: "/services" },
  { label: "Case studies", href: "/#case-studies", match: null },
  { label: "Pricing", href: "/services#packages", match: null },
];
---

<header class="hdr" data-header>
  <a class="hdr__skip" href="#main">Skip to content</a>

  <div class="hdr__inner">
    <a class="hdr__brand" href="/">
      <span class="hdr__logo" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none">
          <path
            d="M12 2.6 20.4 7v10L12 21.4 3.6 17V7L12 2.6Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
          <path
            d="m8.2 12.2 2.6 2.6 5-5.6"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="hdr__name">The Break-Proof Build System</span>
    </a>

    <input class="hdr__toggle" type="checkbox" id="nav-toggle" />
    <label class="hdr__burger" for="nav-toggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>

    <div class="hdr__panel">
      <nav class="hdr__nav" aria-label="Main">
        {
          links.map((l) => (
            <a
              href={l.href}
              aria-current={l.match && l.match === path ? "page" : undefined}
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="hdr__right">
        <span class="hdr__badge">
          <span class="hdr__badge-dot" aria-hidden="true"></span>
          Only 3 build slots this month
        </span>
        <a class="hdr__cta" href="#book">Book a call <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease),
      backdrop-filter 0.3s var(--ease);
    border-bottom: 1px solid transparent;
  }

  /* Applied once the page has scrolled past the very top. */
  .hdr.is-stuck {
    background: rgba(9, 11, 20, 0.82);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom-color: var(--line);
  }

  .hdr__skip {
    position: absolute;
    left: -9999px;
    top: 8px;
    padding: 9px 14px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 13px;
    font-weight: 500;
  }

  .hdr__skip:focus {
    left: 16px;
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 14px 40px;
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex: none;
  }

  .hdr__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid rgba(198, 255, 61, 0.35);
    background: rgba(198, 255, 61, 0.1);
    color: var(--accent);
    flex: none;
    transition: background 0.25s var(--ease);
  }

  .hdr__brand:hover .hdr__logo {
    background: rgba(198, 255, 61, 0.2);
  }

  .hdr__name {
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    transition: color 0.25s var(--ease);
  }

  .hdr__brand:hover .hdr__name {
    color: var(--ink);
  }

  .hdr__panel {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .hdr__nav a {
    position: relative;
    font-size: 14px;
    color: var(--ink-mute);
    text-decoration: none;
    padding: 4px 0;
    transition: color 0.25s var(--ease);
  }

  .hdr__nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .hdr__nav a:hover {
    color: var(--ink);
  }

  .hdr__nav a:hover::after,
  .hdr__nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .hdr__nav a[aria-current="page"] {
    color: var(--accent);
  }

  .hdr__right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hdr__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    border-radius: 20px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .hdr__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-ink);
  }

  .hdr__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .hdr__cta:hover {
    border-color: rgba(198, 255, 61, 0.55);
    background: rgba(198, 255, 61, 0.08);
    transform: translateY(-1px);
  }

  /* Mobile menu, driven by the checkbox rather than a script. */
  .hdr__toggle {
    display: none;
  }

  .hdr__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0 8px;
    border: 1px solid var(--card-line);
    border-radius: 9px;
    cursor: pointer;
    flex: none;
  }

  .hdr__burger span {
    display: block;
    height: 1.5px;
    background: var(--ink-soft);
    border-radius: 2px;
    transition: transform 0.3s var(--ease), opacity 0.25s var(--ease);
  }

  @media (max-width: 940px) {
    .hdr__inner {
      flex-wrap: wrap;
      padding: 12px 24px;
    }

    .hdr__burger {
      display: flex;
    }

    .hdr__panel {
      display: none;
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      width: 100%;
      padding: 18px 2px 6px;
    }

    .hdr__toggle:checked ~ .hdr__panel {
      display: flex;
    }

    .hdr__toggle:checked ~ .hdr__burger span:nth-child(1) {
      transform: translateY(6.5px) rotate(45deg);
    }

    .hdr__toggle:checked ~ .hdr__burger span:nth-child(2) {
      opacity: 0;
    }

    .hdr__toggle:checked ~ .hdr__burger span:nth-child(3) {
      transform: translateY(-6.5px) rotate(-45deg);
    }

    /* The open panel needs a surface even at the top of the page. */
    .hdr:has(.hdr__toggle:checked) {
      background: rgba(9, 11, 20, 0.96);
      backdrop-filter: saturate(140%) blur(14px);
      -webkit-backdrop-filter: saturate(140%) blur(14px);
      border-bottom-color: var(--line);
    }

    .hdr__nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      width: 100%;
    }

    .hdr__nav a {
      width: 100%;
      padding: 11px 0;
      font-size: 15.5px;
      border-bottom: 1px solid var(--line);
    }

    .hdr__nav a::after {
      display: none;
    }

    .hdr__right {
      flex-wrap: wrap;
      width: 100%;
      gap: 12px;
    }

    .hdr__cta {
      flex: 1;
      justify-content: center;
      padding: 12px 18px;
    }
  }

  @media (max-width: 420px) {
    .hdr__name {
      font-size: 10.5px;
      max-width: 15ch;
    }
  }
</style>
