---
/*
  Layered section background: full-bleed pattern → scrim → seam feather →
  accent glow. The scrim repaints the section colour behind the reading
  column, which is what lets the pattern run edge to edge without ever
  sitting behind a headline.

  `glowY` is normally set above 100% or below 0% so the glow straddles a
  section edge and bleeds into the neighbouring section.
*/
interface Props {
  pattern: "grid" | "dots" | "diag" | "rings";
  glow?: "lime" | "blue";
  glowX?: string;
  glowY?: string;
  glowW?: string;
  glowH?: string;
  glowA?: string;
  scrimPos?: string;
  scrimW?: string;
  scrimH?: string;
  patternOpacity?: string;
  /* Corner the pattern is anchored to, and how far it reaches before
     fading out. */
  corner?: string;
  texW?: string;
  texH?: string;
  /* Lime puff behind the headline, as in the hero. */
  puffX?: string;
  puffY?: string;
  puffW?: string;
  puffH?: string;
  puffA?: string;
}

const {
  pattern,
  glow = "lime",
  glowX = "80%",
  glowY = "96%",
  glowW = "620px",
  glowH = "460px",
  glowA = "0.075",
  scrimPos = "38% 44%",
  scrimW = "76%",
  scrimH = "68%",
  patternOpacity = "1",
  corner = "100% 6%",
  texW = "86%",
  texH = "92%",
  puffX = "30%",
  puffY = "20%",
  puffW = "620px",
  puffH = "340px",
  puffA = "0.16",
} = Astro.props;

const scrimStyle = `--scrim-pos:${scrimPos};--scrim-w:${scrimW};--scrim-h:${scrimH};`;
const glowStyle = `--glow-x:${glowX};--glow-y:${glowY};--glow-w:${glowW};--glow-h:${glowH};--glow-a:${glowA};`;
const puffStyle = `--puff-x:${puffX};--puff-y:${puffY};--puff-w:${puffW};--puff-h:${puffH};--puff-a:${puffA};`;
---

<div class="sbg" aria-hidden="true">
  <div
    class={`sbg__pattern sbg__pattern--${pattern}`}
    style={`opacity:${patternOpacity};--tex-corner:${corner};--tex-w:${texW};--tex-h:${texH};`}
  >
  </div>
  <div class="sbg__scrim" style={scrimStyle}></div>
  <div
    class={`sbg__glow${glow === "blue" ? " sbg__glow--blue" : ""}`}
    style={glowStyle}
  >
  </div>
  <div class="sbg__puff" style={puffStyle}></div>
  {/*
    The feather paints last on purpose. The section clips its overflow, so a
    glow or puff reaching the top or bottom edge gets cut off square and the
    clip reads as a hard horizontal line. Painting the section colour over
    those edges last turns the cut into a fade.
  */}
  <div class="sbg__feather"></div>
</div>
