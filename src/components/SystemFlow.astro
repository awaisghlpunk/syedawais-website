---
/* The System — horizontal connected timeline, circle nodes on a shared rail. */
const steps = [
  {
    label: "Meta Ads",
    role: "Fuel",
    body: "The click happens, and before the visitor's even finished typing their phone number, the pixel's already told the CRM which ad sent them. Not tagged later during a weekly report — tagged the second they arrive.",
  },
  {
    label: "GoHighLevel",
    role: "Backbone",
    body: "Not a template pipeline with your logo pasted over someone else's stages. Built around the actual questions your sales process asks, then run against fifty real leads with typos, duplicates, and 2am submissions — before it's ever called finished.",
  },
  {
    label: "AI Automation",
    role: "The Weapon",
    body: "A lead comes in at midnight. Nobody's awake. The system already qualified them, texted back, and put a slot on the calendar before the sun came up — the exact layer that pushed one live system's bookings up 50%.",
  },
  {
    label: "System Bible",
    role: "What You Keep",
    body: "Every workflow has a recorded walkthrough next to it, in plain language. Six months from now, when the person who built it isn't the person you're asking, the answer is already written down.",
  },
];
---

<section class="section" id="how">
  <div class="tex tex-diag" style="--tex-pos: 94% 8%; --tex-size: 290px;"></div>

  <div class="shell">
    <p class="kicker" data-reveal>The Break-Proof Build System</p>
    <h2 class="h2 h2--wide" data-reveal style="--d: 60ms">
      One connected system. Nothing falls through a seam.
    </h2>

    <div class="flow" data-reveal="scale" style="--d: 120ms">
      <div class="flow__rail" aria-hidden="true"></div>

      <ol class="flow__list">
        {
          steps.map((step, i) => (
            <li class="step" data-reveal style={`--d: ${180 + i * 110}ms`}>
              <div class="step__node">
                <span class="step__ring" aria-hidden="true" />
                <span class="step__num mono">{i + 1}</span>
              </div>

              <div class="step__card">
                <h3 class="step__label">{step.label}</h3>
                <p class="step__role">{step.role}</p>
                <p class="step__body">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="transition-note" data-reveal>
      Every build here gets tested against real data before handoff — and backed
      by three guarantees.
    </p>
  </div>
</section>

<style>
  .flow {
    position: relative;
    margin-top: 72px;
  }

  /*
    The connecting rail sits behind the nodes and draws itself in from the
    left when the flow enters the viewport.
  */
  .flow__rail {
    position: absolute;
    top: 27px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(198, 255, 61, 0.45) 8%,
      rgba(198, 255, 61, 0.45) 92%,
      transparent
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.1s var(--ease) 0.25s;
  }

  .flow.is-in .flow__rail {
    transform: scaleX(1);
  }

  .flow__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    position: relative;
  }

  .step__node {
    position: relative;
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--card-line);
    margin-bottom: 28px;
    transition: border-color 0.4s var(--ease), background 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .step__ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid rgba(198, 255, 61, 0.28);
    opacity: 0;
    transform: scale(0.82);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease);
  }

  .step__num {
    font-size: 15px;
    color: var(--ink-mute);
    transition: color 0.4s var(--ease);
  }

  .step:hover .step__node {
    border-color: rgba(198, 255, 61, 0.6);
    background: rgba(198, 255, 61, 0.07);
    transform: translateY(-3px);
  }

  .step:hover .step__ring {
    opacity: 1;
    transform: scale(1);
  }

  .step:hover .step__num {
    color: var(--accent);
  }

  .step__card {
    padding-right: 12px;
  }

  .step__label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 5px;
  }

  .step__role {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .step__body {
    font-size: 15px;
    line-height: 1.68;
    color: var(--ink-mute);
  }

  /* Connector lines must disappear the moment the grid wraps. */
  @media (max-width: 900px) {
    .flow__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px 32px;
    }

    .flow__rail {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .flow {
      margin-top: 48px;
    }

    .flow__list {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .step__node {
      width: 46px;
      height: 46px;
      margin-bottom: 20px;
    }

    .step__label {
      font-size: 17.5px;
    }

    .step__body {
      font-size: 15px;
    }
  }
</style>
