---
/*
  Live pipeline diagram: Meta Ads → funnel → pipeline stages → automated
  messages, animated as one continuous chain on a 12s loop.

  Entirely CSS. Counters are odometers (a column of values stepped through
  with `steps()`), not a script, so this section still ships zero JS.

  The stage counts are authored to sum to the intake figure at every step,
  and every odometer runs on the same delay so they stay in lockstep. If you
  edit these, keep each column of `stages` summing to the same index of
  `intake`, or the panel will contradict itself.

  Figures and contact names are illustrative placeholders, labelled as such
  on the panel. Nothing here is a client's real data.

  LOGOS: the marks below are stylised stand-ins, not the Meta or
  GoHighLevel trademarks. Drop the official SVGs into .lp__watermark and
  .lp__brand to use the real ones.
*/
const intake = ["38", "39", "40", "41", "42", "43"];

const stages = [
  { label: "New lead", values: ["17", "18", "18", "18", "19", "19"], at: 0.7 },
  { label: "Qualified", values: ["11", "11", "12", "12", "12", "13"], at: 3.6 },
  { label: "Booked", values: ["6", "6", "6", "7", "7", "7"], at: 6.5 },
  { label: "Won", values: ["4", "4", "4", "4", "4", "4"], at: 9.4, accent: true },
];

/*
  Five contacts, each offset a fifth of the loop from the next. A stage
  window is under 20% of the cycle wide, so a 20% spacing guarantees no two
  cards ever occupy the same stage and overlap each other.
*/
const contacts = [
  { initials: "RC", name: "Ryan Carter", delay: 0 },
  { initials: "MB", name: "Megan Brooks", delay: -2.4 },
  { initials: "DE", name: "Derek Ellis", delay: -4.8 },
  { initials: "NT", name: "Nicole Turner", delay: -7.2 },
  { initials: "BH", name: "Brandon Hayes", delay: -9.6 },
];

/*
  One toast per stage the contact lands in, timed to that arrival and
  anchored to the right edge of that stage's column so it grows leftward.
  Anchoring the left edge instead pushes any toast wider than one column out
  over the following stage, which is what made the booking message look like
  it belonged to Won. The Won toast is solid so the sequence builds to it.
*/
const toasts = [
  {
    text: "Welcome message sent",
    delay: 0.8,
    pos: "--toast-right:calc(75% + 7px)",
    solid: false,
  },
  {
    text: "Booking confirmed · Reminders scheduled",
    delay: 6.3,
    pos: "--toast-right:calc(25% + 2px)",
    solid: false,
  },
  {
    text: "Deal closed won",
    delay: 9.1,
    pos: "--toast-right:0px",
    solid: true,
  },
];

const messages = [
  { text: "SMS back in seconds", delay: 4.2, icon: "msg" },
  { text: "AI qualifies and replies", delay: 6.4, icon: "ai" },
  { text: "Books the call, confirms it", delay: 8.6, icon: "cal" },
];
---

<div class="lp" data-reveal="scale">
  <div class="lp__head">
    <div>
      <p class="lp__eyebrow mono">Lead intake</p>
      <p class="lp__big mono">
        <span class="odo"
          ><span class="odo__col">{intake.map((v) => <b>{v}</b>)}</span></span
        >
      </p>
    </div>

    <div class="lp__headright">
      <span class="lp__brand">
        <svg viewBox="0 0 120 84" width="17" height="12" aria-hidden="true">
          <path d="M32 26 47 44h-8v32H25V44h-8Z" fill="#FBBC05"></path>
          <path d="M60 40 75 58h-8v18H53V58h-8Z" fill="#4285F4"></path>
          <path d="M88 18l15 18h-8v40H81V36h-8Z" fill="#34A853"></path>
        </svg>
        GoHighLevel
      </span>
      <span class="lp__note mono">Illustrative</span>
    </div>
  </div>

  <div class="lp__row">
    <div class="lp__node">
      {/* The mark in its own blue rather than the site accent. */}
      <svg
        class="lp__meta"
        viewBox="0 0 120 72"
        width="19"
        height="12"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M30 36C30 20 45 20 60 36S90 52 90 36 75 20 60 36 30 52 30 36Z"
          stroke="#0081FB"
          stroke-width="13"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      Meta Ads
    </div>

    <div class="lp__track" aria-hidden="true">
      <span class="lp__pill mono" style="animation-delay:0s">lead</span>
      <span class="lp__pill mono" style="animation-delay:-4s">lead</span>
      <span class="lp__pill mono" style="animation-delay:-8s">lead</span>
    </div>

    <div class="lp__node">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
        <path
          d="M3 5h18l-7 8v6l-4 2v-8L3 5Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      Funnel
    </div>
  </div>

  <div class="lp__link" aria-hidden="true">
    <span class="lp__dot" style="animation-delay:1.4s"></span>
  </div>

  <p class="lp__eyebrow mono">Pipeline</p>

  <div class="lp__board">
    <div class="lp__stages">
      {
        stages.map((s) => (
          <div class="lp__stage" style={`animation-delay:${s.at}s`}>
            <p class="lp__stage-label">{s.label}</p>
            <p class={`lp__stage-num mono${s.accent ? " is-accent" : ""}`}>
              <span class="odo">
                <span class="odo__col">
                  {s.values.map((v) => (
                    <b>{v}</b>
                  ))}
                </span>
              </span>
            </p>
          </div>
        ))
      }
    </div>

    {/* Contact cards advancing stage to stage, over the top of the board. */}
    <div class="lp__movers" aria-hidden="true">
      {
        contacts.map((c) => (
          <span class="lp__contact" style={`animation-delay:${c.delay}s`}>
            <span class="lp__avatar mono">{c.initials}</span>
            {c.name}
          </span>
        ))
      }
    </div>

    {
      toasts.map((t) => (
        <div
          class={`lp__toast${t.solid ? " is-solid" : ""}`}
          style={`animation-delay:${t.delay}s;${t.pos}`}
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none">
            <path
              d="M20 6 9 17l-5-5"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {t.text}
        </div>
      ))
    }
  </div>

  <div class="lp__link" aria-hidden="true">
    <span class="lp__dot" style="animation-delay:9.8s"></span>
  </div>

  <p class="lp__eyebrow mono">Automated messages</p>
  <div class="lp__msgs">
    {
      messages.map((m) => (
        <div class="lp__msg" style={`animation-delay:${m.delay}s`}>
          <span class="lp__msg-icon" aria-hidden="true">
            {m.icon === "msg" && (
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none">
                <path
                  d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
              </svg>
            )}
            {m.icon === "ai" && (
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none">
                <path
                  d="M12 3v3m-5 3h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2Zm2 4v2m6-2v2"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
            {m.icon === "cal" && (
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none">
                <path
                  d="M8 3v3m8-3v3M4 9h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm3 10 2 2 4-4"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
          </span>
          {m.text}
          <span class="lp__sent mono">sent</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .lp {
    position: relative;
    z-index: 2;
    overflow: hidden;
    margin-top: 56px;
    padding: 26px 28px 28px;
    border: 1px solid var(--card-line);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
  }

  .lp__head {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }

  .lp__headright {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }

  .lp__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid rgba(198, 255, 61, 0.4);
    border-radius: 7px;
    background: rgba(198, 255, 61, 0.1);
    color: var(--accent);
    /* Body font, not mono: a mixed-case brand name reads badly with the
       mono face and wide tracking used elsewhere on the panel. */
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .lp__eyebrow {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 8px;
  }

  .lp__big {
    font-size: 40px;
    line-height: 1.05;
    color: var(--accent);
    margin: 0;
  }

  .lp__note {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* Chain ------------------------------------------------------------------ */

  .lp__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lp__node {
    flex: none;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border: 1px solid var(--card-line);
    border-radius: 9px;
    background: rgba(11, 13, 26, 0.5);
    font-size: 13px;
    color: var(--ink-soft);
  }

  .lp__node svg {
    color: var(--accent);
    flex: none;
  }

  /* Carries its own brand colour, so it must not inherit the accent. */
  .lp__meta {
    color: inherit;
  }

  .lp__track {
    position: relative;
    flex: 1;
    min-width: 60px;
    height: 22px;
    /* Pills animate to left:100%, which puts their body past the end of the
       track and on top of the Funnel chip. Clip them to the track. */
    overflow: hidden;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.2) 0 8px,
      transparent 8px 18px
    );
    background-size: 36px 1px;
    background-repeat: repeat-x;
    background-position: 0 50%;
    animation: lp-dash 1.2s linear infinite;
  }

  .lp__pill {
    position: absolute;
    top: 50%;
    margin-top: -9px;
    height: 18px;
    padding: 0 9px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 11px;
    line-height: 18px;
    white-space: nowrap;
    animation: lp-flow 12s linear infinite;
  }

  .lp__link {
    position: relative;
    width: 1px;
    height: 26px;
    margin: 0 auto;
    background: repeating-linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.24) 0 5px,
      transparent 5px 11px
    );
  }

  .lp__dot {
    position: absolute;
    left: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    animation: lp-drop 12s linear infinite;
  }

  /* Pipeline board --------------------------------------------------------- */

  .lp__board {
    position: relative;
    /* Room beneath the stages for the confirmation toast. */
    margin-bottom: 42px;
  }

  .lp__stages {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 9px;
  }

  .lp__stage {
    padding: 11px 13px 44px;
    border: 1px solid var(--card-line);
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.03);
    animation: lp-stage 12s linear infinite;
  }

  .lp__stage-label {
    font-size: 12px;
    color: var(--ink-mute);
    margin: 0 0 6px;
  }

  .lp__stage-num {
    font-size: 19px;
    line-height: 1.05;
    color: var(--ink);
    margin: 0;
  }

  .lp__stage-num.is-accent {
    color: var(--accent);
  }

  /* Contacts advancing across the board ------------------------------------ */

  .lp__movers {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /*
    Sized and stepped off the actual grid geometry: four columns sharing
    three 9px gaps, so a column is (100% - 27px)/4. Using a flat 25% here
    ignores the gaps and the chip drifts into the neighbouring stage.
  */
  .lp__contact {
    position: absolute;
    bottom: 10px;
    width: calc((100% - 27px) / 4 - 16px);
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 5px 8px;
    border: 1px solid rgba(198, 255, 61, 0.4);
    border-radius: 7px;
    background: rgba(198, 255, 61, 0.12);
    font-size: 11.5px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    animation: lp-contact 12s ease-in-out infinite;
  }

  .lp__avatar {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 9px;
    line-height: 18px;
    text-align: center;
  }

  /*
    Only one is visible at a time. Position comes from custom properties set
    per toast, so the media queries below can still override `left`/`right`
    outright: an inline custom property would otherwise outrank them.
  */
  .lp__toast {
    position: absolute;
    left: var(--toast-left, auto);
    right: var(--toast-right, auto);
    bottom: -34px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border-radius: 9px;
    border: 1px solid rgba(198, 255, 61, 0.45);
    background: rgba(198, 255, 61, 0.12);
    color: var(--accent);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.35;
    /* Wraps rather than running the full width of the board. */
    max-width: calc((100% - 27px) / 2 + 9px);
    opacity: 0;
    animation: lp-toast 12s ease-out infinite;
  }

  .lp__toast svg {
    flex: none;
  }

  .lp__toast.is-solid {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* Outbound messages ------------------------------------------------------ */

  .lp__msgs {
    display: grid;
    gap: 8px;
  }

  .lp__msg {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border: 1px solid var(--card-line);
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.03);
    font-size: 13.5px;
    color: var(--ink-soft);
    animation: lp-msg 12s linear infinite;
  }

  .lp__msg-icon {
    display: flex;
    color: var(--accent);
    flex: none;
  }

  .lp__sent {
    margin-left: auto;
    font-size: 11px;
    color: var(--ink-faint);
    flex: none;
  }

  /* Odometer. Every column shares one timing so the stage counts always sum
     to the intake figure. */
  .odo {
    display: inline-block;
    overflow: hidden;
    height: 1.05em;
    line-height: 1.05em;
    vertical-align: -0.08em;
  }

  .odo__col {
    display: block;
    animation: lp-odo 12s steps(6) infinite;
  }

  .odo b {
    display: block;
    height: 1.05em;
    line-height: 1.05em;
    font-weight: 400;
  }

  @keyframes lp-odo {
    to {
      transform: translateY(-6.3em);
    }
  }

  @keyframes lp-flow {
    0% {
      left: 0;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  @keyframes lp-dash {
    to {
      background-position: 36px 0;
    }
  }

  @keyframes lp-drop {
    0% {
      top: 0;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @keyframes lp-stage {
    0% {
      border-color: rgba(198, 255, 61, 0.75);
      background: rgba(198, 255, 61, 0.14);
    }
    14% {
      border-color: var(--card-line);
      background: rgba(255, 255, 255, 0.03);
    }
    100% {
      border-color: var(--card-line);
      background: rgba(255, 255, 255, 0.03);
    }
  }

  /* Advances one stage at a time, pausing in each. */
  @keyframes lp-contact {
    0% {
      left: 8px;
      opacity: 0;
    }
    5% {
      left: 8px;
      opacity: 1;
    }
    22% {
      left: 8px;
      opacity: 1;
    }
    28% {
      left: calc((100% - 27px) / 4 + 17px);
      opacity: 1;
    }
    45% {
      left: calc((100% - 27px) / 4 + 17px);
      opacity: 1;
    }
    51% {
      left: calc((100% - 27px) / 2 + 26px);
      opacity: 1;
    }
    68% {
      left: calc((100% - 27px) / 2 + 26px);
      opacity: 1;
    }
    74% {
      left: calc((100% - 27px) * 0.75 + 35px);
      opacity: 1;
    }
    93% {
      left: calc((100% - 27px) * 0.75 + 35px);
      opacity: 1;
    }
    100% {
      left: calc((100% - 27px) * 0.75 + 35px);
      opacity: 0;
    }
  }

  /* Fires at the start of its own cycle; each toast is offset by its delay
     so it lands with the contact card. */
  @keyframes lp-toast {
    0% {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
    6% {
      opacity: 1;
      transform: none;
    }
    16% {
      opacity: 1;
      transform: none;
    }
    22%,
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @keyframes lp-msg {
    0%,
    100% {
      opacity: 0.3;
      transform: translateX(-6px);
    }
    6% {
      opacity: 1;
      transform: translateX(0);
    }
    34% {
      opacity: 0.95;
      transform: translateX(0);
    }
    50% {
      opacity: 0.3;
      transform: translateX(-6px);
    }
  }

  /* Responsive ------------------------------------------------------------- */

  @media (max-width: 900px) {
    .lp {
      margin-top: 44px;
      padding: 22px 20px 24px;
    }

    .lp__stages {
      grid-template-columns: repeat(2, 1fr);
    }

    .lp__stage {
      padding-bottom: 12px;
    }

    /* The board is two rows here, so left-to-right travel no longer maps to
       stage order. The stage highlight carries the motion instead. */
    .lp__movers {
      display: none;
    }

    .lp__board {
      margin-bottom: 40px;
    }

    .lp__toast {
      left: 0;
      right: auto;
    }
  }

  @media (max-width: 560px) {
    .lp {
      padding: 20px 16px 22px;
      border-radius: 14px;
    }

    .lp__big {
      font-size: 32px;
    }

    .lp__head {
      margin-bottom: 18px;
    }

    .lp__headright {
      flex-direction: column;
      align-items: flex-end;
      gap: 7px;
    }

    .lp__row {
      gap: 8px;
    }

    .lp__node {
      padding: 8px 10px;
      font-size: 12px;
      gap: 6px;
    }

    .lp__track {
      min-width: 34px;
    }

    .lp__pill {
      font-size: 10.5px;
      padding: 0 7px;
    }

    /* One pill in flight: the short track cannot separate three. */
    .lp__pill:nth-child(2),
    .lp__pill:nth-child(3) {
      display: none;
    }

    .lp__stage {
      padding: 10px;
    }

    .lp__stage-label {
      font-size: 11.5px;
    }

    .lp__stage-num {
      font-size: 17px;
    }

    /* Two-row board here, so a per-column anchor is meaningless. */
    .lp__toast {
      left: 0;
      right: auto;
      font-size: 11px;
      padding: 8px 10px;
      white-space: normal;
      max-width: 100%;
    }

    .lp__msg {
      font-size: 12.5px;
      padding: 9px 10px;
      gap: 8px;
    }

    .lp__sent {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp__track,
    .lp__stage,
    .lp__msg,
    .lp__contact,
    .lp__toast,
    .odo__col {
      animation: none !important;
    }

    .lp__pill,
    .lp__dot,
    .lp__toast {
      display: none;
    }

    .lp__msg {
      opacity: 1;
      transform: none;
    }

    .lp__contact {
      left: 0;
      opacity: 1;
    }
  }
</style>
