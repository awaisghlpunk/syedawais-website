---
/*
  The System Wall — edge-to-edge icon grid, cells sharing borders with no gaps.
  Each cell links to the matching case study; the mapping below is inferred,
  since the copy specifies that the links exist but not which pairs with which.
*/
import SectionBg from "./SectionBg.astro";

const systems = [
  {
    title: "24/7 Lead Capture",
    body: "Catches the lead that fills out your form at 3am, same as the one at 3pm",
    href: "#hainan-corporate-services-group",
    icon: "clock",
  },
  {
    title: "Instant Follow-Up",
    body: "Texts back before the lead's even closed the tab",
    href: "#hainan-apex-traders",
    icon: "bolt",
  },
  {
    title: "Never-Miss-A-Call",
    body: "A missed call gets a text reply before the caller's set the phone down",
    href: "#hainan-apex-traders",
    icon: "phone",
  },
  {
    title: "AI Booking System",
    body: "Qualifies and books the call without anyone touching a calendar",
    href: "#hainan-apex-traders",
    icon: "calendar",
  },
  {
    title: "No-Show Recovery",
    body: "A missed appointment gets a follow-up before it becomes a lost customer",
    href: "#hainan-corporate-services-group",
    icon: "return",
  },
  {
    title: "Deliverability Fix",
    body: "The text that used to vanish now actually arrives",
    href: "#hainan-corporate-services-group",
    icon: "send",
  },
  {
    title: "Zero-Chaos CRM",
    body: "The duplicate contact that used to confuse your team gets merged automatically",
    href: "#nationwide-rv",
    icon: "merge",
  },
  {
    title: "Local Visibility System",
    body: "The customer searching for you at 9pm actually finds you",
    href: "#local-seo-home-services",
    icon: "pin",
  },
];

const paths: Record<string, string> = {
  clock: "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  bolt: "M13 2 4 14h7l-1 8 9-12h-7l1-8Z",
  phone:
    "M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z",
  calendar:
    "M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z",
  return: "M9 14 4 9l5-5M4 9h11a5 5 0 0 1 0 10h-3",
  send: "M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z",
  merge: "M7 21V9m0 0L3 13m4-4 4 4M17 3v12m0 0 4-4m-4 4-4-4",
  pin: "M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Zm-8 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
};
---

<section class="section" id="system-wall">
  <SectionBg
    pattern="grid"
    glow="lime"
    glowX="82%"
    glowY="102%"
    glowW="700px"
    glowH="500px"
    scrimPos="34% 22%"
    scrimH="52%"
  />

  <div class="shell">
    <p class="kicker" data-reveal>See the systems</p>
    <h2 class="h2 h2--wide" data-reveal style="--d: 60ms">
      Every system we build, still running somewhere right now.
    </h2>
  </div>

  <div class="wall" data-reveal style="--d: 120ms">
    {
      systems.map((system, i) => (
        <a class="cell" href={system.href} data-reveal style={`--d: ${i * 60}ms`}>
          <span class="cell__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="21" height="21" fill="none">
              <path
                d={paths[system.icon]}
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>

          <h3 class="cell__title">{system.title}</h3>
          <p class="cell__body">{system.body}</p>

          <span class="cell__arrow" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  /*
    Edge-to-edge: the grid spans the full viewport width and cells share
    hairlines instead of sitting in separate cards.
  */
  .wall {
    /* Sits above the section background layers. */
    position: relative;
    z-index: 2;
    margin-top: 64px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .cell {
    position: relative;
    display: block;
    padding: 34px 30px 38px;
    background: var(--bg-alt2);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    overflow: hidden;
    transition: background 0.4s var(--ease);
  }

  .cell::before {
    /* Lime sheen that wipes up from the base of the cell. */
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgba(198, 255, 61, 0.09),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    pointer-events: none;
  }

  .cell:hover {
    background: #141827;
  }

  .cell:hover::before {
    opacity: 1;
  }

  .cell__icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--card-line);
    color: var(--ink-mute);
    margin-bottom: 22px;
    transition: color 0.4s var(--ease), border-color 0.4s var(--ease),
      background 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .cell:hover .cell__icon {
    color: var(--accent);
    border-color: rgba(198, 255, 61, 0.35);
    background: rgba(198, 255, 61, 0.1);
    transform: translateY(-3px);
  }

  .cell__title {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .cell__body {
    position: relative;
    font-size: 15px;
    line-height: 1.66;
    color: var(--ink-body);
  }

  .cell__arrow {
    position: absolute;
    right: 26px;
    bottom: 26px;
    font-size: 15px;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }

  .cell:hover .cell__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 1100px) {
    .wall {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .wall {
      grid-template-columns: repeat(2, 1fr);
      margin-top: 44px;
    }

    .cell {
      padding: 28px 24px 32px;
    }
  }

  @media (max-width: 560px) {
    .wall {
      grid-template-columns: 1fr;
    }

    .cell {
      padding: 24px 24px 26px;
    }

    .cell__icon {
      width: 38px;
      height: 38px;
      margin-bottom: 16px;
    }

    .cell__arrow {
      opacity: 1;
      transform: none;
      right: 24px;
      bottom: 24px;
    }
  }
</style>
