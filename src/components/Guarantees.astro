---
/*
  Guarantees — the one section that deliberately repeats the card grid,
  used here for emphasis.
*/
import SectionBg from "./SectionBg.astro";

const promises = [
  {
    title: "If it breaks, we fix it fast.",
    body: "Something stops working within 30 days, and you didn't touch it: it's fixed free. Within 4 hours. Not “we'll get to it Monday.”",
    stat: "4h",
    statLabel: "Response window",
  },
  {
    title: "You get the full instructions.",
    body: "Every system ships with written instructions and video walkthroughs. You could explain your own system to a stranger in plain English, because you'll actually understand it.",
    stat: "100%",
    statLabel: "Documented",
  },
  {
    title: "It has to save you real time.",
    body: "Not saving 10+ hours a week within 30 days? We keep refining it until it does, at no extra cost, because “close enough” isn't the deal we made.",
    stat: "10+",
    statLabel: "Hours a week",
  },
];
---

<section class="section section--light" id="guarantees">
  <SectionBg
    pattern="grid"
    corner="100% 4%"
    glowX="86%"
    glowY="103%"
    glowW="680px"
    glowH="500px"
    scrimPos="36% 40%"
  />

  <div class="shell">
    <p class="kicker" data-reveal>Built to not break</p>
    <h2 class="h2" data-reveal style="--d: 60ms">
      Three promises that come with every system.
    </h2>

    <div class="promises">
      {
        promises.map((p, i) => (
          <article class="promise" data-reveal style={`--d: ${120 + i * 110}ms`}>
            <div class="promise__top">
              <span class="promise__index mono">0{i + 1}</span>
              <span class="promise__seal" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
                  <path
                    d="M20 6L9 17l-5-5"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </div>

            <h3 class="promise__title">{p.title}</h3>
            <p class="promise__body">{p.body}</p>

            <div class="promise__stat">
              <span class="promise__num mono">{p.stat}</span>
              <span class="promise__label">{p.statLabel}</span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="section-cta" data-reveal>
      <a class="btn btn--outline" href="#case-studies">
        See real results <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .promises {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 64px;
  }

  .promise {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px 30px 28px;
    border-radius: 14px;
    background: var(--card);
    border: 1px solid var(--card-line);
    overflow: hidden;
    transition: transform 0.4s var(--ease), border-color 0.4s var(--ease),
      background 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .promise::before {
    /* Lime wash that fades up from the bottom edge on hover. */
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 100%;
    background: linear-gradient(
      0deg,
      rgba(198, 255, 61, 0.22),
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.45s var(--ease);
    pointer-events: none;
  }

  .promise:hover {
    transform: translateY(-5px);
    border-color: rgba(140, 180, 40, 0.55);
    box-shadow: 0 2px 4px rgba(11, 13, 26, 0.06),
      0 26px 50px -24px rgba(11, 13, 26, 0.34);
  }

  /* The lime seal needs a solid fill to read against white. */
  .promise:hover::before {
    opacity: 1;
  }

  .promise__top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .promise__index {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .promise__seal {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    /*
      Solid fill with a dark tick. A 10% lime wash with a lime tick is
      effectively invisible on the pale ground this section now uses.
    */
    background: var(--accent);
    border: 1px solid rgba(15, 20, 8, 0.16);
    color: var(--accent-ink);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .promise:hover .promise__seal {
    transform: scale(1.1);
    box-shadow: 0 4px 14px -4px rgba(120, 160, 30, 0.7);
  }

  .promise__title {
    position: relative;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.32;
    color: var(--ink);
    margin-bottom: 13px;
  }

  .promise__body {
    position: relative;
    font-size: 15.5px;
    line-height: 1.72;
    color: var(--ink-body);
    flex: 1;
  }

  .promise__stat {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .promise__num {
    font-size: 24px;
    color: var(--accent-text);
    line-height: 1;
  }

  .promise__label {
    font-size: 12px;
    color: var(--ink-faint);
  }

  @media (max-width: 900px) {
    .promises {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-top: 44px;
    }
  }

  @media (max-width: 640px) {
    .promise {
      padding: 26px 22px 24px;
    }

    .promise__title {
      font-size: 18px;
    }
  }
</style>
