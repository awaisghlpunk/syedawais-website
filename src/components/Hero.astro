---
/*
  Hero — recreated from hero-mockup.html as a literal spec.
  Structure and CSS are carried over as-is; the only change is the subhead
  wording, which uses the verbatim line from the copy document.

  Floating tool marks sit either side of the copy. All five are drawn here
  rather than taken from the vendors' asset files, so they are close
  approximations in the right colours, not the actual trademarks.
*/

// Claude's mark is a many-pointed burst: a star with a small inner radius
// gives the same spiky silhouette.
const burst = (() => {
  const pts = [];
  const n = 11;
  for (let i = 0; i < n * 2; i++) {
    const a = (Math.PI * i) / n - Math.PI / 2;
    const r = i % 2 === 0 ? 52 : 13;
    pts.push(`${(60 + r * Math.cos(a)).toFixed(1)},${(60 + r * Math.sin(a)).toFixed(1)}`);
  }
  return pts.join(" ");
})();

const marks = [
  { id: "meta", side: "left", top: "20%", off: "6%", size: 40, dur: 7.5, delay: 0 },
  { id: "n8n", side: "left", top: "45%", off: "11%", size: 42, dur: 9, delay: -2.5 },
  { id: "claude", side: "left", top: "70%", off: "5%", size: 32, dur: 8.2, delay: -5 },
  { id: "ghl", side: "right", top: "26%", off: "7%", size: 36, dur: 8.6, delay: -1.5 },
  { id: "openai", side: "right", top: "52%", off: "12%", size: 32, dur: 7.8, delay: -4 },
  { id: "meta", side: "right", top: "76%", off: "6%", size: 30, dur: 9.4, delay: -6.5 },
];
---

<section class="hero">
  <div class="hero__grid"></div>
  <div class="hero__fade"></div>
  <div class="hero__glow"></div>

  <div class="hero__marks" aria-hidden="true">
    {
      marks.map((m) => (
        <span
          class="floaty"
          style={`top:${m.top};${m.side}:${m.off};--s:${m.size}px;animation-duration:${m.dur}s;animation-delay:${m.delay}s`}
        >
          {m.id === "meta" && (
            <svg viewBox="0 0 120 72" fill="none">
              <path
                d="M30 36C30 20 45 20 60 36S90 52 90 36 75 20 60 36 30 52 30 36Z"
                stroke="#0081FB"
                stroke-width="13"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}

          {m.id === "ghl" && (
            <svg viewBox="0 0 120 84">
              <path d="M32 26 47 44h-8v32H25V44h-8Z" fill="#FBBC05" />
              <path d="M60 40 75 58h-8v18H53V58h-8Z" fill="#4285F4" />
              <path d="M88 18l15 18h-8v40H81V36h-8Z" fill="#34A853" />
            </svg>
          )}

          {m.id === "claude" && (
            <svg viewBox="0 0 120 120">
              <polygon points={burst} fill="#D97757" />
            </svg>
          )}

          {m.id === "openai" && (
            <svg viewBox="0 0 120 120" fill="none">
              <g stroke="#EDEFF5" stroke-width="7">
                <rect x="12" y="37" width="96" height="46" rx="23" />
                <rect
                  x="12"
                  y="37"
                  width="96"
                  height="46"
                  rx="23"
                  transform="rotate(60 60 60)"
                />
                <rect
                  x="12"
                  y="37"
                  width="96"
                  height="46"
                  rx="23"
                  transform="rotate(120 60 60)"
                />
              </g>
            </svg>
          )}

          {m.id === "n8n" && (
            <svg viewBox="0 0 120 64" fill="none">
              <g stroke="#EA4B71" stroke-width="7" stroke-linecap="round">
                <circle cx="14" cy="32" r="9" />
                <circle cx="46" cy="32" r="11" />
                <circle cx="100" cy="14" r="11" />
                <circle cx="100" cy="50" r="11" />
                <path d="M25 32h9" />
                <path d="M57 32h12" />
                <path d="M69 32c9 0 8-18 18-18" />
                <path d="M69 32c9 0 8 18 18 18" />
              </g>
            </svg>
          )}
        </span>
      ))
    }
  </div>

  <div class="hero__content">
    <div class="topbar">
      <div class="topbar__brand">The Break-Proof Build System</div>
      <div class="topbar__right">
        <div class="badge-scarcity">
          <span class="badge-scarcity__dot"></span>
          Only 3 build slots this month
        </div>
        <a href="#book" class="btn-ghost">Book a call →</a>
      </div>
    </div>

    <div class="hero__body">
      <div class="kicker-pill">
        <span class="kicker-pill__dot"></span>
        GHL · Meta Ads · AI Automation
      </div>

      <h1>
        Your GoHighLevel should be booking calls right now.<br />Instead, it's <em
          >losing them.</em
        >
      </h1>

      <p class="subhead-primary">
        Stop losing leads to a system that <span class="accent-em"
          >looks like it's working.</span
        >
      </p>

      <p class="subhead-secondary">
        A lead fills out your form at 11pm. GHL shows the workflow completed.
        Nobody follows up until Monday, and by then they've already booked with
        whoever called them back first.
      </p>

      <div class="cta-row">
        <a href="#audit" class="btn-primary">Show me what's leaking →</a>
        <a href="#how" class="btn-link">See how it's fixed</a>
      </div>
    </div>

    <div class="proof-strip">
      <div class="proof-stat">
        <div class="proof-stat__num">50%</div>
        <div class="proof-stat__label">More bookings, live system</div>
      </div>
      <div class="proof-stat">
        <div class="proof-stat__num">15+</div>
        <div class="proof-stat__label">GHL builds delivered</div>
      </div>
      <div class="proof-stat">
        <div class="proof-stat__num">0</div>
        <div class="proof-stat__label">Manual follow-up</div>
      </div>
    </div>
  </div>

  <a href="#book" class="contact-bubble">
    <span class="contact-bubble__icon">&#9993;</span>
    <span class="contact-bubble__label">Book a call ↗</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /*
      Design-system gradient: the final stop matches --bg-alt so the hero
      dissolves into the section below instead of ending on a hard seam.
      The mockup stops at #131A3A; this adds the documented 4th stop.
    */
    background: linear-gradient(
      115deg,
      #060608 0%,
      #0b0d1a 45%,
      #131a3a 88%,
      #0f1220 100%
    );
  }
  /*
    Drawn with gradients rather than a tiled SVG. The original tile put a
    1px stroke directly on the tile edge, so half of every line was clipped
    and neighbouring tiles failed to join, which showed up as doubled and
    uneven lines. Gradient stops land on whole pixels and stay crisp.
    Scale matches the 112px grid used by the rest of the page.
  */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(46, 52, 80, 0.75) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(46, 52, 80, 0.75) 1px, transparent 1px);
    background-size: 84px 84px;
    /* Settle the grid away from the edges so it reads as depth rather than
       as a sheet laid over the whole section. */
    -webkit-mask-image: radial-gradient(
      ellipse 78% 82% at 50% 42%,
      #000 0%,
      rgba(0, 0, 0, 0.75) 48%,
      rgba(0, 0, 0, 0.25) 74%,
      transparent 94%
    );
    mask-image: radial-gradient(
      ellipse 78% 82% at 50% 42%,
      #000 0%,
      rgba(0, 0, 0, 0.75) 48%,
      rgba(0, 0, 0, 0.25) 74%,
      transparent 94%
    );
  }
  .hero__fade {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 55% at 50% 45%,
      #0b0d1a 0%,
      rgba(11, 13, 26, 0.88) 40%,
      transparent 75%
    );
  }
  .hero__glow {
    position: absolute;
    top: 38%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 560px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(198, 255, 61, 0.2) 0%,
      transparent 70%
    );
    pointer-events: none;
  }
  .hero__content {
    position: relative;
  }

  /* --- Floating tool marks --------------------------------------------- */

  .hero__marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .floaty {
    position: absolute;
    width: var(--s);
    display: block;
    opacity: 0.55;
    animation-name: floatY;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }

  .floaty svg {
    width: 100%;
    height: auto;
  }

  @keyframes floatY {
    from {
      transform: translateY(-9px) rotate(-2deg);
    }
    to {
      transform: translateY(9px) rotate(2deg);
    }
  }

  /*
    Below this the centred copy reaches the full width of the hero and the
    marks would sit on top of the headline, so they come out entirely.
  */
  @media (max-width: 1150px) {
    .hero__marks {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floaty {
      animation: none;
    }
  }

  /* Top bar */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .topbar__brand {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: #9a9cac;
    text-transform: uppercase;
  }
  .topbar__right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .badge-scarcity {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #c6ff3d;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    color: #0b0c14;
  }
  .badge-scarcity__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0b0c14;
  }
  .btn-ghost {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
    padding: 9px 18px;
    border-radius: 20px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Hero body */
  .hero__body {
    padding: 72px 40px 24px;
    text-align: center;
  }
  .kicker-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.05);
    color: #b9bbcc;
    font-size: 13px;
    padding: 7px 16px;
    border-radius: 20px;
    margin-bottom: 28px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .kicker-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c6ff3d;
  }

  h1 {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.06;
    letter-spacing: -0.01em;
    color: #ffffff;
    max-width: 780px;
    margin: 0 auto 26px;
  }
  h1 em,
  .accent-em {
    font-style: italic;
    color: #c6ff3d;
  }

  .subhead-primary {
    font-size: 21px;
    line-height: 1.5;
    color: #e4e5ec;
    max-width: 540px;
    margin: 0 auto 14px;
  }
  .subhead-secondary {
    font-size: 15px;
    line-height: 1.6;
    color: #8a8ca0;
    max-width: 480px;
    margin: 0 auto 40px;
  }

  .cta-row {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 64px;
  }
  .btn-primary {
    background: #c6ff3d;
    color: #0b0c14;
    font-size: 15px;
    font-weight: 500;
    padding: 16px 28px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .btn-link {
    color: #ffffff;
    font-size: 15px;
    font-weight: 500;
    padding: 16px 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    text-decoration: none;
  }

  /* Proof strip */
  .proof-strip {
    padding: 26px 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: center;
    gap: 64px;
    flex-wrap: wrap;
  }
  .proof-stat {
    text-align: center;
  }
  .proof-stat__num {
    font-family: "JetBrains Mono", monospace;
    font-size: 24px;
    font-weight: 500;
    color: #c6ff3d;
  }
  .proof-stat__label {
    font-size: 12px;
    color: #6e7080;
    margin-top: 4px;
  }

  /* Floating contact bubble */
  .contact-bubble {
    position: absolute;
    bottom: 24px;
    right: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 10px 16px;
    border-radius: 24px;
    text-decoration: none;
  }
  .contact-bubble__icon {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(198, 255, 61, 0.13);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #c6ff3d;
    font-size: 15px;
  }
  .contact-bubble__label {
    font-size: 13px;
    color: #c6ff3d;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .topbar {
      flex-direction: column;
      gap: 14px;
      align-items: flex-start;
      padding: 18px 24px;
    }
    .hero__body {
      padding: 48px 24px 16px;
    }
    .proof-strip {
      gap: 32px;
      padding: 24px;
    }
    .contact-bubble {
      position: static;
      margin: 24px auto;
      width: fit-content;
    }
  }

  /* ---- Additive polish only. Nothing above this line is altered. ---- */

  .hero__glow {
    animation: heroGlow 7s ease-in-out infinite alternate;
  }

  @keyframes heroGlow {
    from {
      opacity: 0.75;
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  .btn-primary,
  .btn-ghost,
  .btn-link,
  .contact-bubble {
    transition:
      transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 0.25s cubic-bezier(0.22, 0.61, 0.36, 1),
      border-color 0.25s cubic-bezier(0.22, 0.61, 0.36, 1),
      background 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px -10px rgba(198, 255, 61, 0.5);
  }

  .btn-ghost:hover,
  .contact-bubble:hover {
    border-color: rgba(198, 255, 61, 0.5);
    background: rgba(198, 255, 61, 0.07);
    transform: translateY(-2px);
  }

  .btn-link:hover {
    border-bottom-color: #c6ff3d;
    color: #c6ff3d;
  }

  .proof-stat__num {
    transition: transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .proof-stat:hover .proof-stat__num {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__glow {
      animation: none;
    }
  }
</style>
